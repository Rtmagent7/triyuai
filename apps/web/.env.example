# "enabled": prototype mode, the browser and server components use the MSW mock API and
# CoinGecko snapshot fixtures (no backend needed). "disabled": use the Express API (apps/api).
NEXT_PUBLIC_API_MOCKING=enabled

# Real-API mode only. The browser calls same-origin /api/v1 and Next.js proxies it to
# API_ORIGIN, so auth cookies stay first-party. Server components call API_ORIGIN directly.
# API_ORIGIN=http://localhost:4000
# Same value as INTERNAL_API_KEY in apps/api: server-rendered pages skip the per-IP rate limit.
# INTERNAL_API_KEY=
# "enabled" shows Continue with Google (needs GOOGLE_CLIENT_ID/SECRET on the API).
# NEXT_PUBLIC_GOOGLE_LOGIN=
# Error monitoring (Sentry project DSN, public by design). Off when unset.
# NEXT_PUBLIC_SENTRY_DSN=

# Public URL used for metadata, OG images and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
