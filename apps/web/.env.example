# Phase 1: the browser talks to the MSW mock API. Set to "disabled" once the Express API exists.
NEXT_PUBLIC_API_MOCKING=enabled
# Base URL of the API (Phase 3). Same-origin /api/v1 is intercepted by MSW in Phase 1.
NEXT_PUBLIC_API_URL=/api/v1

# Public URL used for metadata, OG images and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
