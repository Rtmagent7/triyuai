{
  "name": "@triyuai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "build": "prisma generate && esbuild src/vercel.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:@node-rs/argon2 --external:@electric-sql/pglite --external:pglite-prisma-adapter --external:pg-native --external:pino --external:pino-http --external:pino-pretty --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "vercel-build": "pnpm build && if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy; fi"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.97",
    "@ai-sdk/groq": "4.0.62",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@triyuai/shared": "workspace:*",
    "@upstash/redis": "1.39.0",
    "ai": "7.0.141",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "pglite-prisma-adapter": "0.7.2",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5"
  }
}
