# Copy to .env. Every service is optional in development:
# without them the API uses an embedded Postgres, an in-memory cache and the keyless CoinGecko API.

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Neon Postgres (pooled connection string). Default: embedded PGlite in ./.pglite
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/triyuai?sslmode=require

# Upstash Redis (REST). Default: in-memory cache (fine for a single local process)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# CoinGecko Demo API key (free). Default: keyless public API with a much lower rate limit
# COINGECKO_API_KEY=

# At least 32 random characters in production: openssl rand -base64 48
# JWT_SECRET=
# IP_HASH_SALT=
# Same value as INTERNAL_API_KEY in apps/web: lets server-rendered pages skip the per-IP rate limit
# INTERNAL_API_KEY=

# Ask TRIYU: Groq first, Gemini as fallback. Without either, /ai/chat returns 503.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Sign in with Google (OAuth web client). Authorised redirect URI: <WEB_ORIGIN>/api/v1/auth/google/callback.
# Without both, the Google button stays hidden and /auth/google sends users back to /login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
