{
  "name": "triyuai",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "fixtures": "node scripts/fetch-fixtures.ts",
    "sectors": "node scripts/fetch-sectors.ts",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @triyuai/web test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  }
}
